node_modules/
dist/

# Session cookies, HAR captures, and anything else that carries live
# iCloud credentials. Never commit these.
.auth/
*.har
*.local.json
*.local.*

# Archive of HAR captures used to reverse-engineer the CloudKit wire format,
# plus a .md description alongside each one. Untracked apart from the README
# that describes the convention, since the .har files carry live session data
# and the descriptions name real notes - see har_captures/README.md.
/har_captures/*
!/har_captures/README.md

# Cloned test vaults (real note content) - never commit these. Anchored to
# the repo root so it doesn't also swallow src/notes/.
/notes/

# iOS device-automation harness (see harness/HARNESS.md): deliberately kept
# out of the public repo - it carries the device UDID, plus real note
# content and screenshots under forensics/ and shots/.
/harness/
